# ==============================================================================
# OpenRouter API Configuration Template
# ------------------------------------------------------------------------------
# To configure locally:
# 1. Copy this file to .env or .env.local
# 2. Insert your actual OpenRouter API key below
# 3. Insert your verified OpenRouter model identifier (intended: Gemini 3.1 Flash)
#
# NOTE: Never commit actual API keys or credentials to GitHub!
# ==============================================================================

# OpenRouter API Key
VITE_OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY_HERE

# OpenRouter Model Identifier (Intended model: Gemini 3.1 Flash)
# (e.g., google/gemini-2.0-flash-001 or your verified OpenRouter model string)
VITE_OPENROUTER_MODEL=YOUR_OPENROUTER_MODEL_HERE
